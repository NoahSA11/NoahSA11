{
  "name": "shvil",
  "version": "1.0.0",
  "description": "Shvil — an offline Chumash learning game built on Sefaria data",
  "scripts": {
    "fetch": "tsx scripts/fetch-sefaria.ts",
    "content": "tsx scripts/build-content.ts",
    "audit": "tsx scripts/audit-questions.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "vite",
    "build": "npm run content && vite build && tsx scripts/build-sw.ts",
    "preview": "vite preview --port 4173",
    "screenshots": "tsx scripts/screenshots.ts",
    "e2e": "tsx scripts/e2e.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoahSA11/NoahSA11.git"
  },
  "license": "GPL-2.0-or-later",
  "bugs": {
    "url": "https://github.com/NoahSA11/NoahSA11/issues"
  },
  "homepage": "https://github.com/NoahSA11/NoahSA11#readme",
  "devDependencies": {
    "@hebcal/core": "^6.14.7",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource/frank-ruhl-libre": "^5.3.0"
  },
  "private": true,
  "type": "module"
}
